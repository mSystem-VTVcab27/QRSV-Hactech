<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1tesst.DiplomaPage"
             Shell.NavBarIsVisible="False"
             Title="Tra cứu văn bằng"
             BackgroundColor="#F4F6F9">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Top Navigation Bar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" BackgroundColor="White" Padding="15,10">
            <Button Grid.Column="0" Text="‹ Quay lại" Clicked="OnBackClicked" BackgroundColor="Transparent" TextColor="#2563EB" FontAttributes="Bold" FontSize="15" Padding="5,0"/>
            <Label Grid.Column="1" Text="Tra cứu văn bằng" TextColor="#0F172A" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
            <Button Grid.Column="2" Text="🔄 Tải lại" Clicked="OnReloadClicked" BackgroundColor="Transparent" TextColor="#64748B" FontSize="14" Padding="5,0"/>
        </Grid>

        <!-- Loading Activity Indicator -->
        <ActivityIndicator x:Name="loadingIndicator" Grid.Row="1" IsRunning="True" IsVisible="True" Color="#2563EB" HorizontalOptions="Center" VerticalOptions="Center" ZIndex="10"/>

        <!-- Embedded WebView -->
        <WebView x:Name="diplomaWebView"
                 Grid.Row="1"
                 Navigating="OnWebViewNavigating"
                 Navigated="OnWebViewNavigated"/>

    </Grid>

</ContentPage>
